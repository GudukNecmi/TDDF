[gd_resource type="Resource" script_class="RunCard" format=3]

[ext_resource type="Script" path="res://Scripts/Run/run_card.gd" id="1_card"]
[ext_resource type="Script" path="res://Scripts/Weapons/devils_coin.gd" id="2_coin"]
[ext_resource type="PackedScene" path="res://Scenes/World/Pickups/BloodCoin.tscn" id="3_coin_scene"]
[ext_resource type="PackedScene" path="res://Scenes/Effects/BloodCoinBurst.tscn" id="4_burst"]

[sub_resource type="Resource" id="Resource_coin"]
script = ExtResource("2_coin")
blood_reward = 20
lifetime = 2.0
pickup_radius = 44.0
coin_scene = ExtResource("3_coin_scene")
coin_scale = 1.0
glow_scale = 1.0
pulse_rate = 2.2
end_pulse_rate_multiplier = 2.2
pulse_strength = 0.45
fade_duration = 0.35
pickup_burst = ExtResource("4_burst")

[resource]
script = ExtResource("1_card")
id = &"devils_coin"
display_name = "DEVIL'S COIN"
description = "EVERY MAN THE SHOTGUN KILLS DROPS A BLOOD COIN WHERE HE FELL. WALK OVER IT WITHIN 2 SECONDS FOR EXTRA BLOOD - LEAVE IT AND IT FADES."
price = 120
kill_reward = SubResource("Resource_coin")
weapon_ids = Array[StringName]([&"shotgun"])
